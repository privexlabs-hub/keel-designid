{
  "name": "keel-brand-id",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:glyphs": "node scripts/lint-glyphs.mjs",
    "assets:fonts": "node scripts/fetch-fonts.mjs",
    "assets:logos": "node scripts/build-logos.mjs",
    "assets:pngs": "node scripts/build-pngs.mjs",
    "assets:embed": "node scripts/embed-fonts.mjs",
    "assets": "npm run assets:fonts && npm run assets:logos && npm run assets:pngs && npm run assets:embed",
    "verify:assets": "node scripts/verify-assets.mjs",
    "check:subsets": "node scripts/check-subsets.mjs",
    "prebuild": "node scripts/verify-assets.mjs && node scripts/lint-glyphs.mjs",
    "typecheck": "tsc --noEmit",
    "verify:responsive": "node scripts/verify/responsive.mjs",
    "verify:export": "node scripts/verify/export-gate.mjs",
    "verify:shots": "node scripts/verify/shots.mjs",
    "verify:all": "npm run typecheck && npm run lint && npm run lint:glyphs && npm run verify:assets && npm run verify:responsive && npm run verify:export && npm run verify:editor && npm run verify:batch",
    "serve:out": "python3 -m http.server 8099 --directory out",
    "verify:editor": "node scripts/verify/editor.mjs",
    "verify:batch": "node scripts/verify/batch.mjs"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "idb-keyval": "^6.3.0",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "modern-screenshot": "^4.7.0",
    "nanoid": "^5.1.16",
    "next": "16.3.1",
    "opentype.js": "^1.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "png-to-ico": "^3.0.2",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.34.5",
    "svgo": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wawoff2": "^2.0.1"
  }
}
